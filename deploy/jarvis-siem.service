[Unit]
Description=Jarvis SIEM Dashboard Server
After=network.target

[Service]
WorkingDirectory=/home/kyle/pi-siem
ExecStart=/home/kyle/pi-siem/.venv/bin/python3 /home/kyle/pi-siem/jarvis_siem_server.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
